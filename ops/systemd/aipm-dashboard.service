[Unit]
Description=AIPM Mission Control dashboard (read-only)
After=network-online.target aipm-telemetry.service aipm-events.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/aipm
Environment=PYTHONUNBUFFERED=1
Environment=AIPM_CONFIG=/home/mina/.config/aipm/config.yaml
Environment=AIPM_TELEMETRY_DB=/home/mina/.local/state/aipm/telemetry/mission_control.db
ExecStart=/home/ubuntu/aipm/.venv/bin/aipm dashboard --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/ubuntu/aipm /home/mina/.config/aipm /home/mina/.local/state/aipm/telemetry
ReadWritePaths=/home/mina/.local/state/aipm/logs
InaccessiblePaths=/home/ubuntu/.ssh
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=default.target
