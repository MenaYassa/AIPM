[Unit]
Description=AIPM Mission Control event processor
After=network-online.target aipm-telemetry.service
Wants=network-online.target
Requires=aipm-telemetry.service

[Service]
Type=simple
User=aipm
Group=aipm
WorkingDirectory=/home/ubuntu/aipm
Environment=PYTHONUNBUFFERED=1
Environment=AIPM_TELEMETRY_DB=/var/lib/aipm/state/telemetry/mission_control.db
ExecStart=/home/ubuntu/aipm/.venv/bin/aipm events run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/aipm/state/telemetry /var/lib/aipm/logs
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
